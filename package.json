{
  "name": "film-finder-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "npm run typecheck && npm run lint && npm run db:check && npm run bot:check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "LOG_LEVEL=error tsx src/db/check-search.ts",
    "tmdb:check": "LOG_LEVEL=warn tsx src/services/check-tmdb.ts",
    "db:studio": "drizzle-kit studio",
    "bot:check": "LOG_LEVEL=error tsx src/bot/check-pipeline.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/storage-redis": "^2.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
