# ── Telegram ─────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# Ваш telegram id (узнать: @userinfobot). Несколько — через запятую.
ADMIN_IDS=

# ID приватного канала-хранилища. Понадобится на этапе 3.
# Как узнать: переслать любой пост из канала в @getidsbot.
# Обязательно с минусом и префиксом -100, например -1003755407567
STORAGE_CHANNEL_ID=

# ── Инфраструктура ───────────────────────────────────────────────────
# Локально — нативный Postgres (brew postgresql@14) на порту 5433.
# 5432 занят другой установкой PostgreSQL, поэтому порт нестандартный.
DATABASE_URL=postgres://filmfinder:filmfinder@localhost:5433/filmfinder

# Если у Redis задан requirepass, пароль идёт в URL:
# redis://default:<пароль>@localhost:6379
REDIS_URL=redis://localhost:6379

# ── Внешние сервисы ──────────────────────────────────────────────────
# themoviedb.org/settings/api — бесплатно. Понадобится на этапе 3.
TMDB_API_KEY=

# ── Поведение ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Через сколько минут удалять выданный фильм.
# Потолок 2820 (47 часов): сообщения старше 48 часов Telegram удалять не даёт.
AUTO_DELETE_MINUTES=2820

# Предлагать ли месячный тариф ещё и с автопродлением (Telegram Stars
# Subscriptions). Период фиксированный — 30 суток, другого Bot API не даёт.
# false — продавать только разовыми счетами.
STARS_AUTO_RENEW=true

# ── Гейт на каналы спонсоров ─────────────────────────────────────────
# Сколько каналов показывать в гейте. Больше трёх-пяти люди не проходят.
SPONSOR_MAX_CHANNELS=3

# Сколько фильмов в сутки можно посмотреть бесплатно, пройдя гейт.
# 0 — без ограничения. Подписчиков не касается.
FREE_VIEWS_PER_DAY=3

# На сколько секунд запоминать пройденный гейт.
# 0 — проверять подписку на каждый запрос фильма: отписался — доступ пропал сразу.
# Больше нуля — меньше запросов к Telegram, но столько же секунд после отписки
# фильмы ещё выдаются.
SPONSOR_CACHE_SEC=0

# ── Рефералка ────────────────────────────────────────────────────────
# Сколько дней получают оба — пригласивший и приглашённый.
# Начисляются, когда приглашённый посмотрит первый фильм. 0 — выключить.
REFERRAL_BONUS_DAYS=3

# Сколько приглашений в сутки оплачивается одному человеку.
# Сверх лимита приглашение записывается, но дней за него не даётся.
REFERRAL_DAILY_LIMIT=10

# ── Прод ─────────────────────────────────────────────────────────────
# Публичный адрес сервиса. Задан — бот работает на вебхуке, пуст — на polling.
# Вебхук нужен там, где хостинг требует занятый порт (web service).
# WEBHOOK_URL=https://film-finder.onrender.com

# Порт HTTP-сервера. На Render и подобных подставляется платформой.
# Без вебхука сервер поднимается только ради /healthz и только если порт задан.
# PORT=3000
